# 复制为 .env 后填写真实值；.env 已被 .gitignore 排除，不会进仓库。

# 邮箱 SMTP 授权码（QQ 邮箱：设置 → 账户 → 开启 SMTP 服务 → 生成授权码）
QQ_SMTP_AUTH=

# 收发件地址（留空则使用 config.json 里的 mail.from / mail.to）
MAIL_FROM=your_account@qq.com
MAIL_TO=your_account@qq.com

# 画像独立收件人（profiles/legal 用这个键，避免两份日报串到同一个邮箱）
# MAIL_TO_LEGAL=your_account@qq.com

# 以下均为可选
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# CHROME_PROFILE_DIR=./chrome-profile
# CHROME_DEBUG_PORT=9333
# JOB_DB_PATH=./jobs.db
